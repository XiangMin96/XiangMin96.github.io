<!DOCTYPE html>
<html lang="<%= config.language %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <%_
    var pageTitle = config.title;
    if (page.title) pageTitle = page.title + ' | ' + config.title;
    else if (is_category()) pageTitle = '分类：' + page.category + ' | ' + config.title;
    else if (is_tag()) pageTitle = '标签：' + page.tag + ' | ' + config.title;
    else if (is_archive()) pageTitle = '归档 | ' + config.title;
    var pageDesc = page.description || (page.excerpt
      ? truncate(strip_html(page.excerpt.replace(/<blockquote[\s\S]*?<\/blockquote>/g, '')).trim(), {length: 120})
      : config.description);
  _%>
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>">
  <%- open_graph({image: url_for(theme.avatar)}) %>
  <link rel="icon" href="<%- url_for('favicon.svg') %>" type="image/svg+xml">
  <link rel="stylesheet" href="<%- url_for('css/style.css') %>">
  <script>
    // 在渲染前应用已保存的主题，避免闪烁
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t) document.documentElement.dataset.theme = t;
      } catch (e) {}
    })();
  </script>
  <%- meta_generator() %>
</head>
<body>
  <a class="skip-link" href="#main">跳到正文</a>
  <%- partial('_partial/header') %>
  <%- body %>
  <%- partial('_partial/footer') %>
  <script src="<%- url_for('js/main.js') %>" defer></script>
</body>
</html>
