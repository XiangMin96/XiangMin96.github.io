<article class="post">
  <header class="page-header">
    <div class="container narrow">
      <div class="post-meta">
        <%_ if (page.categories && page.categories.length) { _%>
          <%_ page.categories.each(function (c) { _%>
            <a class="chip chip-light" href="<%- url_for(c.path) %>"><%= c.name %></a>
          <%_ }) _%>
        <%_ } _%>
      </div>
      <h1 class="page-title"><%= page.title %></h1>
      <p class="page-info">
        <time datetime="<%= date_xml(page.date) %>"><%= date(page.date, 'YYYY-MM-DD') %></time>
        · <%= wordcount(page.content) %> 字 · 约 <%= min2read(page.content) %> 分钟
      </p>
    </div>
  </header>

  <%_ var tocHtml = toc(page.content, {list_number: false, max_depth: 3}); _%>
  <div class="container post-layout<%- tocHtml ? ' has-toc' : '' %>">
    <main id="main" class="post-body">
      <div class="markdown">
        <%- page.content %>
      </div>

      <footer class="post-footer">
        <%_ if (page.tags && page.tags.length) { _%>
          <div class="tag-cloud">
            <%_ page.tags.each(function (t) { _%>
              <a class="chip" href="<%- url_for(t.path) %>">#<%= t.name %></a>
            <%_ }) _%>
          </div>
        <%_ } _%>
        <p class="copyright"><%= theme.copyright %></p>
        <nav class="post-nav" aria-label="上一篇和下一篇">
          <%_ if (page.prev) { _%>
            <a class="post-nav-item" href="<%- url_for(page.prev.path) %>"><span>较新文章</span><%= page.prev.title %></a>
          <%_ } else { _%><span></span><%_ } _%>
          <%_ if (page.next) { _%>
            <a class="post-nav-item next" href="<%- url_for(page.next.path) %>"><span>较早文章</span><%= page.next.title %></a>
          <%_ } _%>
        </nav>
      </footer>
    </main>

    <%_ if (tocHtml) { _%>
      <aside class="toc" aria-label="文章目录">
        <div class="toc-inner">
          <p class="toc-title">目录</p>
          <%- tocHtml %>
        </div>
      </aside>
    <%_ } _%>
  </div>
</article>
